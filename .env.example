# ==============================================================================
# NoBrokerHood (NBH) Accounting AI - Production Environment Configuration
# ==============================================================================
# COPY THIS FILE TO .env FOR LOCAL/DEPLOYMENT CONFIGURATION.
# NEVER COMMIT REAL CREDENTIALS, KEYS, OR SENSITIVE IDS TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION RUNTIME & SECURITY SETTINGS
# ------------------------------------------------------------------------------
# Environment: 'production', 'staging', or 'development'
ENVIRONMENT=production

# Set to 'false' in production. Disables debug features and stack traces.
DEBUG=false

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# OpenAPI/Swagger interactive documentation (/docs, /redoc, /openapi.json).
# Set to 'false' in production to disable public API schema documentation.
ENABLE_DOCS=false

# Development login bypass (/auth/dev-login).
# MUST BE 'false' IN PRODUCTION. Only set to 'true' in isolated local test environments.
ALLOW_DEV_LOGIN=false

# Session inactivity timeout in seconds (1200 seconds = 20 minutes)
SESSION_INACTIVITY_SECONDS=1200
SESSION_HEARTBEAT_GRACE_SECONDS=120

# Cryptographic random secret used to secure session tokens
SESSION_SECRET=<YOUR_RANDOM_PRODUCTION_SESSION_SECRET>

# Maximum file upload size in megabytes
MAX_FILE_SIZE_MB=10

# Allowed CORS origins (comma-separated list of exact web origins).
# Wildcard '*' is strictly prohibited for authenticated production deployments.
CORS_ALLOWED_ORIGINS=https://accounting.nobrokerhood.com,https://nobrokerhood.github.io

# ------------------------------------------------------------------------------
# 2. GOOGLE WORKSPACE AUTHENTICATION (OAUTH 2.0)
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Client ID for Web Applications
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>

# Organization Google Workspace domain restriction (e.g., nobroker.in)
ALLOWED_EMAIL_DOMAIN=nobroker.in

# Allow any verified active user in the organization domain without explicit User_Master entry
ALLOW_DOMAIN_WIDE_ACCESS=true

# ------------------------------------------------------------------------------
# 3. GOOGLE CLOUD SERVICE ACCOUNT (DRIVE & SHEETS INTEGRATION)
# ------------------------------------------------------------------------------
# Provide EITHER the inline JSON string OR an absolute filesystem path to the key file.
# For containers/PaaS (Cloud Run, ECS, Render), GOOGLE_SERVICE_ACCOUNT_JSON is recommended.
GOOGLE_SERVICE_ACCOUNT_JSON=<YOUR_SERVICE_ACCOUNT_KEY_JSON_STRING>
# GOOGLE_SERVICE_ACCOUNT_FILE=/etc/secrets/service-account.json

# ------------------------------------------------------------------------------
# 4. GOOGLE SHARED DRIVE (ENTERPRISE DOCUMENT STORE)
# ------------------------------------------------------------------------------
# The Google Workspace Shared Drive ID containing accounting folders
GOOGLE_SHARED_DRIVE_ID=<YOUR_GOOGLE_SHARED_DRIVE_ID>

# Google Sheets Spreadsheet ID for configuration, templates, audit logs, and job state
GOOGLE_ACCOUNTING_SPREADSHEET_ID=<YOUR_GOOGLE_SPREADSHEET_ID>

# Worksheet/tab names within the accounting spreadsheet (defaults shown)
GOOGLE_USER_MASTER_SHEET_ID=User_Master
GOOGLE_FOLDER_CONFIG_SHEET_ID=Folder_Config
GOOGLE_TEMPLATE_MASTER_SHEET_ID=Template_Master
GOOGLE_MAPPING_MASTER_SHEET_ID=Mapping_Master
GOOGLE_PROCESSING_LOG_SHEET_ID=Processing_Log
GOOGLE_ACTIVITY_LOG_SHEET_ID=Activity_Log
GOOGLE_LOGIN_AUDIT_SHEET_ID=Login_Audit
GOOGLE_SESSION_LOG_SHEET_ID=Session_Log
GOOGLE_API_USAGE_SHEET_ID=API_Usage_Report

# Purpose-specific folder IDs (Optional overrides for Folder_Config sheet entries)
# MEMBER_RECEIPT_INCOMING_FOLDER_ID=<FOLDER_ID>
# MEMBER_RECEIPT_REVIEW_FOLDER_ID=<FOLDER_ID>
# MEMBER_RECEIPT_COMPLETED_FOLDER_ID=<FOLDER_ID>
# MEMBER_RECEIPT_OUTPUT_FOLDER_ID=<FOLDER_ID>
# VENDOR_INVOICE_INCOMING_FOLDER_ID=<FOLDER_ID>
# VENDOR_INVOICE_REVIEW_FOLDER_ID=<FOLDER_ID>
# VENDOR_INVOICE_COMPLETED_FOLDER_ID=<FOLDER_ID>
# VENDOR_INVOICE_OUTPUT_FOLDER_ID=<FOLDER_ID>

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
# Gemini API Key from Google AI Studio / Google Cloud Vertex AI
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# Gemini model to use for multimodal extraction and verification
GEMINI_MODEL=gemini-2.5-flash

# Maximum verification retry attempts before requesting human review (default: 2)
AI_VERIFICATION_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 6. EXTERNAL DEPENDENCIES
# ------------------------------------------------------------------------------
# Directory containing Poppler utilities (pdfinfo, pdftoppm).
# If Poppler binaries are in system PATH (standard Linux Docker), leave empty.
# On Windows development machines: D:\poppler\bin or similar.
POPPLER_PATH=
